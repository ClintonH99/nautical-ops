{
  "name": "yachy-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prepare": "husky",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "expo:go": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web && node scripts/copy-public-to-dist.mjs",
    "vercel-build": "npx expo export --platform web && node scripts/copy-public-to-dist.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "eas:login": "eas login",
    "eas:submit:ios": "eas submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/drawer": "^7.9.2",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.95.3",
    "base64-js": "^1.5.1",
    "expo": "^57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-auth-session": "~57.0.11",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-iap": "4.3.1",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-location": "~57.0.16",
    "expo-modules-core": "~57.0.17",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "lottie-react-native": "~7.3.8",
    "posthog-react-native": "^4.41.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-signature-canvas": "^5.1.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
