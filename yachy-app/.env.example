# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
#
# For EAS / TestFlight / store builds: add the SAME names in expo.dev → Environment variables
# (production). See docs/EAS_TESTFLIGHT_SUPABASE.md

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Social Auth (Google & Apple) - configure providers in Supabase Dashboard
# Dashboard: Auth > Providers > enable Google & Apple
# Add redirect URL to Supabase Auth > URL Configuration: nauticalops://**

# OpenAI API (for AI Store Finder - to be added later)
# EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key

# Paddle Billing — set as Supabase Edge Function secrets only (not in the Expo app)
# https://supabase.com/dashboard/project/_/settings/functions
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENV=sandbox
