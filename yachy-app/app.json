{
  "expo": {
    "name": "Nautical Ops",
    "slug": "nautical-ops",
    "scheme": "nauticalops",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.nauticalops.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nauticalops.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1b2a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-iap",
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nautical Ops to access your camera",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nautical Ops to access your photos for profile and vessel images."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "nautical-ops-mobile",
          "organization": "nautical-ops"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eb067a9d-d949-45a2-b3a1-15867c609436"
      },
      "privacyUrl": "https://nautical-ops.com/privacy-policy"
    },
    "owner": "clintonh99",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb067a9d-d949-45a2-b3a1-15867c609436"
    }
  }
}
