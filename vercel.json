{
  "installCommand": "cd yachy-app && npm install",
  "buildCommand": "cd yachy-app && npm run vercel-build",
  "outputDirectory": "yachy-app/dist",
  "routes": [
    { "src": "/", "dest": "/landing.html" },
    { "handle": "filesystem" },
    { "src": "/pricing", "dest": "/pricing.html" },
    { "src": "/privacy-policy", "dest": "/privacy-policy.html" },
    { "src": "/refund-policy", "dest": "/refund-policy.html" },
    { "src": "/terms-and-conditions", "dest": "/terms-and-conditions.html" },
    { "src": "/support", "dest": "/support.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
