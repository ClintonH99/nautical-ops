{
  "installCommand": "cd yachy-app && npm install",
  "buildCommand": "cd yachy-app && npm run vercel-build",
  "outputDirectory": "yachy-app/dist",
  "framework": null,
  "rewrites": [
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/terms-and-conditions.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
